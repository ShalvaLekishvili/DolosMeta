FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PATH=/opt/dolosmeta/bin:$PATH \
    TEMP_DIR=/app/data/tmp

WORKDIR /app
RUN groupadd --system dolosmeta \
    && useradd --system --gid dolosmeta --home-dir /nonexistent --shell /usr/sbin/nologin dolosmeta \
    && python -m venv /opt/dolosmeta

COPY backend /app/backend
RUN /opt/dolosmeta/bin/pip install --no-cache-dir /app/backend \
    && mkdir -p /app/data/tmp \
    && chown -R dolosmeta:dolosmeta /app/data

USER dolosmeta
EXPOSE 8000
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD python -c "import os, urllib.request; urllib.request.urlopen('http://127.0.0.1:%s/api/v1/health' % os.getenv('PORT', '8000'), timeout=2)"
CMD ["sh", "-c", "exec uvicorn dolosmeta.app:app --app-dir backend --host 0.0.0.0 --port ${PORT:-8000} --no-server-header"]
